---
import Logo from './Logo.astro';
import { site, nav, url } from '../data/site';
const clean = (p: string) => p.replace(/\/$/, '') || '/';
const path = clean(Astro.url.pathname);
const isCurrent = (href: string) => path === clean(url(href));
---
<header class="site-header">
  <div class="inner">
    <a class="brand" href={url('/')}>
      <Logo />
      <span class="brand-name">Island Style <span>Junk Removal</span></span>
    </a>
    <nav class="main-nav" aria-label="Main">
      {nav.map((item) => (
        <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-cta">
      <a class="btn btn-outline" href={`tel:${site.phoneDigits}`}>{site.phoneShort}</a>
      <a class="btn btn-gold btn-small" href={url('/contact/')}>Free Quote</a>
    </div>
  </div>
</header>
