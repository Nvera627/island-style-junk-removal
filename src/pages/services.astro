---
import Layout from '../layouts/Layout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import QuotePanel from '../components/QuotePanel.astro';
import { services } from '../data/services';
---
<Layout title="Services" description="Island Style Junk Removal hauls furniture, appliances, mattresses, electronics, cleanouts, move-outs and light debris in Charlotte, NC. Free quotes.">
  <section class="page-intro">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h1>If we can move it, <span>we'll haul it.</span></h1>
      <p>Here is what we take. Every job starts with a free quote. No pressure, no surprises.</p>
    </div>
  </section>

  <section class="section-flush">
    <div class="wrap stack">
      <div class="cards">
        {services.map((s) => (
          <div class="card">
            <ServiceIcon name={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
      <p class="note"><strong>Yard waste is case by case.</strong> Send us a photo and we'll tell you if we can take it. Not on the list? Ask anyway.</p>
    </div>
  </section>

  <QuotePanel />
</Layout>
