---
import Layout from '../layouts/Layout.astro';
import QuotePanel from '../components/QuotePanel.astro';
---
<Layout title="Contact" description="Call, text or send a quote request to Island Style Junk Removal in Charlotte, NC. Free quotes. Calls 7am to 7pm.">
  <section class="page-intro">
    <div class="wrap">
      <span class="eyebrow">Contact</span>
      <h1>Let's get it <span>gone.</span></h1>
      <p>Call, text a photo, or fill out the form. We'll get back to you with a free quote.</p>
    </div>
  </section>

  <QuotePanel />
</Layout>
